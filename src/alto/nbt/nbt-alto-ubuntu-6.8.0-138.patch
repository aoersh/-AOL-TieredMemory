--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -3187,6 +3187,25 @@
 
 #define VMA_PID_RESET_PERIOD (4 * sysctl_numa_balancing_scan_delay)
 
+unsigned int sysctl_numa_balancing_pte_scale = 16;
+unsigned int sysctl_numa_balancing_reset_kswapd_failures;
+
+/* ALTO keeps a prefix of each scan range, in sixteenths (16 = stock NBT). */
+static unsigned long change_prot_numa_alto(struct vm_area_struct *vma,
+		unsigned long start, unsigned long end, unsigned long *scanned_end)
+{
+	unsigned int scale = READ_ONCE(sysctl_numa_balancing_pte_scale);
+	unsigned long limit;
+
+	*scanned_end = start;
+	if (!scale || end <= start)
+		return 0;
+	limit = scale >= 16 ? end :
+		min(end, ALIGN(start + ((end - start) / 16) * scale, HPAGE_SIZE));
+	*scanned_end = limit;
+	return change_prot_numa(vma, start, limit);
+}
+
 /*
  * The expensive part of numa migration is done from task_work context.
  * Triggered from task_tick_numa().
